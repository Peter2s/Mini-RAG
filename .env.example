# App
APP_NAME=Mini-RAG
DEBUG=false

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/mini_rag.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=[".txt", ".md", ".pdf"]

# Chunking
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# Embeddings: "hash" (offline, lexical, for dev) or "voyage" (semantic, needs `pip install voyageai`)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSION=512
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# LLM (Claude). Leave the key empty to use ANTHROPIC_API_KEY from the environment
# or an `ant auth login` profile.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=16000
LLM_EFFORT=medium
LLM_ENABLE_FALLBACKS=true
