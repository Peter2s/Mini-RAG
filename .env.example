# App
APP_NAME=Mini-RAG
DEBUG=false

# MongoDB. docker-compose.yml creates the root user from MONGO_ROOT_*;
# keep MONGODB_URL's credentials in sync with them.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me
MONGO_PORT=27017
MONGODB_URL=mongodb://admin:change-me@localhost:27017
MONGODB_DATABASE=mini_rag

# Vector store: "qdrant" (dedicated vector database, see docker-compose.yml) or "mongodb"
# (brute-force search over MongoDB; no extra service, fine for small collections).
# docker-compose.yml starts Qdrant with QDRANT_API_KEY; the app sends the same key.
VECTOR_STORE=qdrant
QDRANT_API_KEY=change-me
QDRANT_URL=http://localhost:6333
# Prefix: each embedding model gets its own Qdrant collection, "<prefix>__<model>".
QDRANT_COLLECTION=chunks
QDRANT_PORT=6333

# File storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=[".txt", ".md", ".pdf"]

# Chunking
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# Embeddings: "fastembed" (free, local, multilingual incl. Arabic), "voyage" (hosted API,
# needs `uv sync --extra voyage`), or "hash" (offline word matching, for tests only).
# After changing the provider or model, call /index on each collection: chunks not yet
# embedded by the new model are picked up automatically.
EMBEDDING_PROVIDER=fastembed
# 1.2 GB, 2048-token input, best Arabic and English-to-Arabic results in our test.
# Lighter alternative (0.22 GB, faster, shorter input):
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_MODEL=google/embeddinggemma-300m
MODELS_DIR=./data/models
EMBEDDING_DIMENSION=512
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
VOYAGE_DIMENSION=1024

# LLM (Claude). Leave the key empty to use ANTHROPIC_API_KEY from the environment
# or an `ant auth login` profile.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=16000
LLM_EFFORT=medium
LLM_ENABLE_FALLBACKS=true
